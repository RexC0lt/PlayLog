# PlayLog configuration — copy to .env and fill in.
# NEVER commit the real .env (it is git-ignored).

# --- required: single application password -------------------------------
# Only a salted bcrypt hash of this is stored in the SQLite database.
APP_PASSWORD=change-me-to-a-long-random-password

# --- server ---------------------------------------------------------------
# Host port the container publishes (container always listens on $PORT too).
PORT=8787
# How long a login session stays valid.
SESSION_TTL_HOURS=24

# --- scheduler --------------------------------------------------------------
# Steam library sync interval, in hours (also runs once at container start).
SYNC_INTERVAL_HOURS=12

# --- Steam Web API (phase 2 sync) -------------------------------------------
# Get a key at https://steamcommunity.com/dev/apikey (any domain works).
# STEAM_ID64 is your 64-bit Steam ID, e.g. from https://steamid.io
# IMPORTANT: your Steam profile privacy settings must have
# "Game Details" set to PUBLIC, otherwise the owned-games API returns nothing.
STEAM_API_KEY=
STEAM_ID64=

# --- IGDB (metadata + cover art) ---------------------------------------------
# Create an app at https://dev.twitch.tv/console/apps to get these credentials.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
